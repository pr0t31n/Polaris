# Polaris port forwards — run after session opens
# Usage: resource /opt/pr0t31n/Polaris/portfwd.rc
#
# Forwards appliance services to C2 server high ports.
# Uses 127.0.0.1 since services run on the appliance itself.

sessions -c "portfwd add -l 25100 -p 5100 -r 127.0.0.1"
sessions -c "portfwd add -l 25500 -p 5500 -r 127.0.0.1"
sessions -c "portfwd add -l 28834 -p 8834 -r 127.0.0.1"

echo ""
echo "Port forwards active:"
echo "  server:25100 -> appliance:5100 (Vantage)"
echo "  server:25500 -> appliance:5500 (Crucible)"
echo "  server:28834 -> appliance:8834 (Nessus)"
echo ""
